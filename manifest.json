{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "1.0.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "48": "assets/icons/listing-48.png",
    "96": "assets/icons/listing-96.png"
  },
  "permissions": ["storage", "https://www.google.com/*", "https://api.ipify.org/*"],
  "optional_permissions": ["https://*/*"],
  "background": {
    "scripts": [
      "types.js",
      "format.js",
      "model.js",
      "storage.js",
      "monitor.js",
      "export.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_area": "navbar",
    "default_title": "Network Speed Monitor",
    "default_icon": "assets/icons/toolbar-white.svg",
    "theme_icons": [
      {
        "light": "assets/icons/toolbar-white.svg",
        "dark": "assets/icons/toolbar-black.svg",
        "size": 16
      }
    ],
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html#settings",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "network-speed-monitor@example.local",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "152.0"
    }
  }
}
