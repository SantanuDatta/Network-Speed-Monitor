{
  "name": "network-speed-monitor-firefox",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-for-amo": "npm run build",
    "dev": "npm run build && web-ext run --source-dir dist --start-url about:debugging#/runtime/this-firefox",
    "format": "oxfmt --write . --ignore-path .gitignore --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check . --ignore-path .gitignore --ignore-path .oxfmtignore",
    "lint:oxlint": "oxlint src tests --deny-warnings",
    "lint:web-ext": "web-ext lint --source-dir dist --no-input",
    "lint": "tsc --noEmit && npm run lint:oxlint",
    "test": "vitest run",
    "version:sync": "node scripts/sync-version.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
